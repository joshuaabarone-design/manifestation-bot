# Fastlane lanes for Manifest (iOS). Requires macOS + Xcode; not run in this repo's CI by default.
#
# Required environment variables (never commit these):
#   ASC_KEY_ID       App Store Connect API key ID
#   ASC_ISSUER_ID    App Store Connect issuer ID
#   ASC_KEY_CONTENT  Contents of the .p8 key (or base64 of it with ASC_KEY_IS_BASE64=true)
#   TEAM_ID          Apple Developer Team ID
#   APP_IDENTIFIER   Bundle ID (default com.joshuabarone.manifestation)
#   VITE_API_BASE_URL  Hosted API URL baked into the web bundle
#
# Usage (from ios/App):  bundle exec fastlane beta   |   bundle exec fastlane release

default_platform(:ios)

platform :ios do
  def asc_key
    %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_CONTENT].each do |k|
      UI.user_error!("Missing #{k}") if ENV[k].to_s.empty?
    end
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: ENV["ASC_KEY_IS_BASE64"] == "true",
      in_house: false
    )
  end

  def app_id
    ENV.fetch("APP_IDENTIFIER", "com.joshuabarone.manifestation")
  end

  private_lane :prepare do
    UI.user_error!("Missing TEAM_ID") if ENV["TEAM_ID"].to_s.empty?
    UI.user_error!("Missing VITE_API_BASE_URL") if ENV["VITE_API_BASE_URL"].to_s.empty?
    Dir.chdir("../../..") do
      sh("npm", "ci")
      sh("npm", "run", "build:web")
      sh("npx", "cap", "sync", "ios")
    end
    update_app_identifier(
      xcodeproj: "App.xcodeproj",
      plist_path: "App/Info.plist",
      app_identifier: app_id
    )
    update_code_signing_settings(
      path: "App.xcodeproj",
      use_automatic_signing: true,
      team_id: ENV["TEAM_ID"],
      bundle_identifier: app_id
    )
  end

  def build
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV['TEAM_ID']} PRODUCT_BUNDLE_IDENTIFIER=#{app_id}"
    )
  end

  desc "Build and upload to TestFlight (does not submit for review)"
  lane :beta do
    api_key = asc_key
    prepare
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: latest_testflight_build_number(api_key: api_key, app_identifier: app_id, initial_build_number: 0) + 1
    )
    build
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "Build and upload a release binary to App Store Connect. Submission for review stays manual."
  lane :release do
    api_key = asc_key
    prepare
    build
    upload_to_app_store(
      api_key: api_key,
      submit_for_review: false,
      automatic_release: false,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end
end
